#!/usr/bin/env bash
# Short wrapper so mobile commands stay tiny:
#   ./gy            -> this week's eligible list (top 50)
#   ./gy 5          -> week 5 eligible list
#   ./gy u "Name"   -> mark a player used
#   ./gy l          -> list used players
#   ./gy x "Name"   -> undo a used player
set -euo pipefail
cd "$(dirname "$0")"
case "${1:-}" in
  u) shift; exec python3 graveyard.py use "$@" ;;
  x) shift; exec python3 graveyard.py unuse "$@" ;;
  l) exec python3 graveyard.py used ;;
  ''|*[!0-9]*) exec python3 graveyard.py rankings "$@" ;;
  *) wk="$1"; shift; exec python3 graveyard.py rankings --week "$wk" "$@" ;;
esac
